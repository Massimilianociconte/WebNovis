# Cloudflare Workers static assets — regole _redirects.
# GitHub Pages NON legge questo file: diventa attivo solo su Cloudflare.
# Docs: https://developers.cloudflare.com/workers/static-assets/redirects/
# NB: html_handling è "none" (vedi wrangler.jsonc) → gli URL .html restano canonici.
#     Le regole qui sotto gestiscono indici di directory e redirect legacy.

# --- Rewrite (200): indici di directory (necessari con html_handling: none) ---
/ /index.html 200
/servizi/ /servizi/index.html 200
/blog/ /blog/index.html 200
/agenzia-web/ /agenzia-web/index.html 200
/realizzazione-siti-web/ /realizzazione-siti-web/index.html 200
/zone-servite/ /zone-servite/index.html 200

# --- 301: normalizzazioni ---
/index.html / 301
/servizi /servizi/ 301
/blog /blog/ 301
/agenzia-web /agenzia-web/ 301
/realizzazione-siti-web /realizzazione-siti-web/ 301
/zone-servite /zone-servite/ 301

# --- 301 legacy espliciti (da server.js legacyPathRedirects) ---
# MANTENUTO: alias plurale -> singolare (il file plurale e noindex con canonical al singolare).
/agenzie-web-rho.html /agenzia-web-rho.html 301
# 2026-09-03 (rettifica): i 301 sotto sono LOAD-BEARING su questo layer.
# dist/ pubblica solo contenuti indicizzabili (prepare-public-artifact.js):
# le famiglie GEO deprecate non esistono sul Worker, quindi senza 301
# darebbero 404. Su server.js (dev) i file esistono e vengono serviti.
# Non rimuovere finché le famiglie non tornano in dist/.
/accessibilita-rho.html /servizi/accessibilita.html 301
/social-media-rho.html /servizi/social-media.html 301
/chiedere-recensioni-clienti /blog/chiedere-recensioni-clienti.html 301

# 2026-09-03 (rettifica): blocco wildcard GEO RIPRISTINATO sullo stesso
# principio — sul Worker queste famiglie non esistono (v. sopra): il wildcard
# preserva equity verso le pagine servizio invece di 404. De-amplificazione
# resta via meta noindex dove i file sono serviti (dev/origin).
/accessibilita-* /servizi/accessibilita.html 301
/copywriting-* /servizi/consulenze.html 301
/fotografia-aziendale-* /servizi/graphic-design.html 301
/web-app-* /servizi/sviluppo-web.html 301
/automazione-business-* /servizi/consulenze.html 301
/restyling-sito-web-* /servizi/sviluppo-web.html 301
/manutenzione-sito-* /servizi/sviluppo-web.html 301
/sviluppo-app-mobile-* /servizi/sviluppo-web.html 301
/consulenze-* /servizi/consulenze.html 301

